# =============================================================================
#  DevBlog ortam değişkenleri
#  Kullanım:  cp .env.example .env   → değerleri değiştir →  docker compose up -d --build
#  .env dosyası ASLA commit'lenmez (.gitignore). Üretimde değerler secret store'dan gelir
#  (K8s Secret / Vault / GitHub Environments).
# =============================================================================

# --- Genel ------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production (production'da /docs kapanır)
LOG_LEVEL=INFO
IMAGE_TAG=local

# --- Dışa açılan portlar ------------------------------------------------------
GATEWAY_PORT=8080                # Tek giriş noktası: http://localhost:8080
GRAFANA_PORT=3000                # yalnızca 127.0.0.1
PROMETHEUS_PORT=9090             # yalnızca 127.0.0.1
RABBITMQ_UI_PORT=15672           # yalnızca 127.0.0.1
MSSQL_PORT=14330                 # yalnızca 127.0.0.1 (SSMS / Azure Data Studio)

# --- Gizli değerler (ÜRETİMDE MUTLAKA DEĞİŞTİR) ------------------------------
# MSSQL şifre politikası: en az 8 karakter; büyük, küçük harf, rakam ve sembol
MSSQL_SA_PASSWORD=DevBlog_Str0ng!Pass
REDIS_PASSWORD=devblog-redis-pass
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin
RABBITMQ_USER=devblog
RABBITMQ_PASSWORD=devblog-rabbit-pass
# En az 32 karakter rastgele değer:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-min-32-chars!!
IP_HASH_SALT=dev-only-ip-hash-salt
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=devblog-grafana

# --- İlk açılışta oluşturulan yazar hesabı ------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@devblog.local
ADMIN_DISPLAY_NAME=Blog Yazarı
ADMIN_PASSWORD=Admin123!

# --- Güvenlik ----------------------------------------------------------------
COOKIE_SECURE=false              # HTTPS arkasında (staging/prod) true

# --- Build --------------------------------------------------------------------
FRONTEND_RUN_TESTS=true          # frontend imajı build edilirken typecheck + vitest
